{
  "manifest_version": 3,
  "name": "API Profiler Links for Symfony",
  "version": "1.1.0",
  "description": "Lists your app's XHR and fetch calls in a DevTools tab and opens the Symfony profiler for each one in one click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "devtools_page": "devtools.html",
  "host_permissions": [
    "*://localhost/*",
    "*://*.localhost/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "api-profiler-links-symfony@jacques.moati.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
